# Server port
PORT=3001

# Set to 'production' in deployment
NODE_ENV=development

# Admin panel password — change this before deploying!
ADMIN_KEY=wc2026admin

# SQLite database path (relative to server/)
DB_PATH=../data/wc2026.db

# Allowed CORS origin (leave blank for * in dev)
CLIENT_URL=http://localhost:5173

# Live scores API (worldcup26.ir)
# Option A — paste your JWT token directly:
WORLDCUP_API_TOKEN=
# Option B — provide credentials and the server will authenticate on startup:
WORLDCUP_API_EMAIL=
WORLDCUP_API_PASSWORD=
# Auto-sync interval in minutes (0 = disabled, 5 = every 5 min recommended)
WORLDCUP_SYNC_INTERVAL=0
