# Server port
PORT=3001

# Set to 'production' in deployment
NODE_ENV=development

# Admin panel password — change this before deploying!
ADMIN_KEY=wc2026admin

# SQLite database path (relative to server/)
DB_PATH=../data/wc2026.db

# Allowed CORS origin (leave blank for * in dev)
CLIENT_URL=http://localhost:5173
